	<parameter name="DentistID" class="java.lang.Integer"/>
	<query language="sql"><![CDATA[SELECT 
  TP.TreatmentPlanID        AS TreatmentPlanID,
  S.StaffID                 AS DentistID,
  R.RoleID,
  R.RoleName,
  P.FirstName               AS PatientFirstName,
  P.LastName                AS PatientLastName,
  TP.StartDate,
  TP.Status,
  T.TreatmentType,
  T.TreatmentPhase,
  S.FirstName               AS DentistFirstName,
  S.LastName                AS DentistLastName,
  
  (SELECT MIN(TP2.StartDate)
   FROM TreatmentPlan TP2
   WHERE TP2.StartDate > TP.StartDate) AS UpcomingTreatment

FROM Treatment T
  JOIN Staff S         ON T.StaffID = S.StaffID
  JOIN Role R          ON S.RoleID = R.RoleID
  JOIN TreatmentPlan TP ON T.TreatmentPlanID = TP.TreatmentPlanID
  JOIN Patient P       ON TP.PatientID = P.PatientID

WHERE
  S.StaffID = $P{DentistID}
  AND R.RoleID = 1
  AND TP.Status = 'Active'
]]></query>
